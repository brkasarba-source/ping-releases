# ---- VFS hesabınız ----
VFS_EMAIL=ornek@mail.com
VFS_PASSWORD=sifreniz

# Adres: https://visa.vfsglobal.com/<VFS_COUNTRY>/<VFS_LANGUAGE>/<VFS_MISSION>
# Türkiye'den Çekya başvurusu için: tur / tr / cze
VFS_COUNTRY=tur
VFS_LANGUAGE=tr
VFS_MISSION=cze

# Sitedeki açılır listelerde görünen metnin bir parçası (büyük/küçük harf ve Türkçe karakter fark etmez).
# Birden fazla merkez virgülle ayrılır.
VFS_CENTRES=Istanbul,Ankara
VFS_CATEGORY=Kısa Süreli
VFS_SUBCATEGORY=Turizm

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# ---- Zamanlama (dakika) ----
# Çok sık sorgu VFS hesabınızın/IP'nizin geçici olarak engellenmesine yol açar. 5 dakikanın altına inmeyin.
CHECK_INTERVAL_MINUTES=6
CHECK_JITTER_MINUTES=2
BLOCKED_BACKOFF_MINUTES=60
# Randevu açık kalmaya devam ederse kaç dakikada bir hatırlatılsın
REMIND_MINUTES=30
CAPTCHA_WAIT_SECONDS=300

# ---- Tarayıcı ----
# false: tarayıcı penceresi görünür (Cloudflare'i geçmek için önerilir)
HEADLESS=false
# Bilgisayarınızda kurulu Google Chrome'u kullanmak için "chrome" yazın (Cloudflare'e daha az takılır)
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_DIR=browser-profile
