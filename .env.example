# ---- VFS hesabınız ----
VFS_EMAIL=ornek@mail.com
VFS_PASSWORD=sifreniz

# Adres: https://visa.vfsglobal.com/<VFS_COUNTRY>/<VFS_LANGUAGE>/<VFS_MISSION>
# Türkiye'den Çekya başvurusu için: tur / tr / cze
VFS_COUNTRY=tur
VFS_LANGUAGE=tr
VFS_MISSION=cze

# Sitedeki açılır listelerde görünen metnin bir parçası (büyük/küçük harf ve Türkçe karakter fark etmez).
# Birden fazla merkez virgülle ayrılır.
VFS_CENTRES=Altunizade,Beyoglu
VFS_CATEGORY=Short Term
VFS_SUBCATEGORY=Turizm

# OTP kodunu Outlook'tan otomatik oku (önce bir kez: python vfs_bot.py --outlook-login).
# Okuyamazsa kodu Telegram'dan ister.
OTP_FROM_OUTLOOK=true
# Kurumsal/okul hesabı: https://outlook.office.com/mail   Kişisel hesap: https://outlook.live.com/mail/0
OUTLOOK_MAIL_URL=https://outlook.office.com/mail

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# ---- Zamanlama (dakika) ----
# Çok sık sorgu VFS hesabınızın/IP'nizin geçici olarak engellenmesine yol açar. 15 dakikanın altına inmeyin.
CHECK_INTERVAL_MINUTES=15
CHECK_JITTER_MINUTES=5
# Bir merkezden diğerine geçmeden önce bekleme (VFS 30-45 sn bekletiyor)
CENTRE_WAIT_MIN_SECONDS=45
CENTRE_WAIT_MAX_SECONDS=60
BLOCKED_BACKOFF_MINUTES=180
# Randevu açık kalmaya devam ederse kaç dakikada bir hatırlatılsın
REMIND_MINUTES=30
# Bot kaç saatte bir 'çalışıyorum' mesajı atsın (0 = kapalı). Ayrıca Telegram'a /durum yazabilirsiniz.
HEARTBEAT_HOURS=3
CAPTCHA_WAIT_SECONDS=300

# ---- Tarayıcı ----
# false: tarayıcı penceresi görünür (Cloudflare'i geçmek için önerilir)
HEADLESS=false
# Boş bırakılırsa: kurulu Brave varsa o, yoksa yerleşik Chromium kullanılır.
# Google Chrome için "chrome", Edge için "msedge" yazabilirsiniz.
BROWSER_CHANNEL=
# Belirli bir tarayıcının .exe yolu (isteğe bağlı)
BROWSER_PATH=
BROWSER_PROFILE_DIR=browser-profile
